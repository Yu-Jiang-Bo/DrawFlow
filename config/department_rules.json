{
  "version": 1,
  "default": {
    "label_fields": ["order_no", "color_option"],
    "label_lines": [["order_no"], ["color_option"]],
    "apply_color_to_artwork": false,
    "show_frame": false
  },
  "rules": [
    {
      "name": "H",
      "display_name": "H 部门",
      "description": "标注订单号和定制信息，不带框；效果图本体按订单字体颜色渲染。",
      "match": "exact",
      "departments": ["H"],
      "label_fields": ["order_no", "text"],
      "label_lines": [["order_no"], ["text"]],
      "apply_color_to_artwork": true,
      "show_frame": false
    },
    {
      "name": "K_T_FK_ZK",
      "display_name": "K/T/FK/ZK 部门",
      "description": "标注订单号和字体颜色，不带框；同订单同颜色的多个定制内容共用一组标注，竖向排成一列。",
      "match": "exact",
      "departments": ["K", "T", "FK", "ZK"],
      "label_fields": ["order_no", "color_option"],
      "label_lines": [["order_no"], ["color_option"]],
      "apply_color_to_artwork": false,
      "show_frame": false
    },
    {
      "name": "D_CONTAINS",
      "display_name": "含 D 部门",
      "description": "标注订单号和产品名称，输出带框设计图。",
      "match": "contains",
      "departments": ["D"],
      "label_fields": ["order_no", "product_name"],
      "label_lines": [["order_no"], ["product_name"]],
      "apply_color_to_artwork": false,
      "show_frame": true
    },
    {
      "name": "PW_EW",
      "display_name": "PW/EW 部门",
      "description": "标注订单号、产品名称和字体颜色，输出设计图。",
      "match": "exact",
      "departments": ["PW", "EW"],
      "label_fields": ["order_no", "product_name", "color_option"],
      "label_lines": [["order_no"], ["product_name", "color_option"]],
      "apply_color_to_artwork": false,
      "show_frame": false
    }
  ]
}
