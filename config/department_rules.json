{
  "version": 1,
  "default": {
    "label_fields": ["order_no", "color_option"],
    "label_lines": [["order_no"], ["color_option"]],
    "apply_color_to_artwork": false,
    "show_frame": false
  },
  "shop_rules": {
    "source_file": "test/ai测试/部门作图要求和细节.xls",
    "interpretation": "表格中的“定制信息”指系统生成的实际效果图/作图内容，不是订单表里的原始定制文字。",
    "current_render_policy": "本机渲染按本节执行最终部门排版和成品格式；中央服务不保存成品。H 逐效果图导出 CMYK PNG 并额外生成裁剪总 PNG，W 仅对 MY-W196 与 MY-W120 使用厂家例外。",
    "global_requirements": {
      "default_output_color_mode": "CMYK",
      "allowed_output_color_modes": ["CMYK", "RGB"],
      "must_outline_text": true,
      "must_pathfinder_merge": true,
      "size_frame_text_path_overlap": true,
      "size_frame_text_path_overlap_note": "所有带尺寸框的内容，文字部分要与对应的尺寸框路径完全重合。",
      "outline_dedupe_note": "输出文件一定要做转曲去重处理，去重很重要。",
      "keep_same_order_together": true
    },
    "department_output_requirements": [
      {
        "name": "ZW",
        "departments": ["ZW"],
        "output_format": "ai8",
        "artwork_content": "订单号 + 曲线标题效果图",
        "save_strategy": "保持曲线标题模板的单个整体 AI8 输出"
      },
      {
        "name": "T",
        "departments": ["T"],
        "output_format": "ai8",
        "exportUnit": "PER_ORDER",
        "fileFormat": "AI8",
        "fillActualColor": false,
        "annotation_type": "COLOR",
        "single_order_ai": true,
        "hasMaster": true,
        "cropMasterHeight": true,
        "master_group_by_color": true,
        "master_frame_width_mm": 580,
        "master_frame_height_mm": 2000,
        "artwork_content": "订单号 + 字体颜色 + 效果图",
        "save_strategy": "先按单保存，再按颜色排版为一个整体 AI8 文件",
        "layout": {
          "group_by_color": true,
          "frame_width_mm": 580,
          "frame_height_mm": 2000,
          "color_label_outside_frame": true,
          "keep_same_order_together": true,
          "master_packing": {
            "algorithm": "adaptive_column_grid",
            "target_width_mm": 580,
            "item_gap_mm": 2,
            "column_gap_mm": 2,
            "outer_margin_mm": 2,
            "header_height_mm": 7,
            "color_gap_mm": 4,
            "label_height_mm": 4,
            "label_gap_mm": 0.8,
            "row_slack": 1,
            "cell_width_padding_mm": 0.8,
            "component_suppress_labels": true,
            "force_subitem_order_labels": false,
            "allow_rotation": false
          }
        },
        "file_naming": "店名+几单几图日期+生产部门，例如 T-5411D58T0816T"
      },
      {
        "name": "K",
        "departments": ["K"],
        "output_format": "ai8",
        "exportUnit": "PER_ORDER",
        "fileFormat": "AI8",
        "fillActualColor": false,
        "annotation_type": "COLOR",
        "single_order_ai": true,
        "hasMaster": true,
        "cropMasterHeight": true,
        "master_group_by_color": true,
        "master_frame_width_mm": 480,
        "master_frame_height_mm": 2000,
        "artwork_content": "订单号 + 字体颜色 + 效果图",
        "save_strategy": "先按单保存，再按颜色排版为一个整体 AI8 文件",
        "layout": {
          "group_by_color": true,
          "frame_width_mm": 480,
          "frame_height_mm": 2000,
          "color_label_outside_frame": true,
          "keep_same_order_together": true,
          "master_packing": {
            "algorithm": "adaptive_column_grid",
            "target_width_mm": 480,
            "item_gap_mm": 2,
            "column_gap_mm": 2,
            "outer_margin_mm": 2,
            "header_height_mm": 7,
            "color_gap_mm": 4,
            "label_height_mm": 4,
            "label_gap_mm": 0.8,
            "row_slack": 1,
            "cell_width_padding_mm": 0.8,
            "component_suppress_labels": true,
            "force_subitem_order_labels": false,
            "allow_rotation": false
          }
        },
        "file_naming": "店名+几单几图日期+生产部门，例如 T-5411D58T0816K"
      },
      {
        "name": "ZK_FK",
        "departments": ["ZK", "FK"],
        "output_format": "ai8",
        "exportUnit": "PER_ORDER",
        "fileFormat": "AI8",
        "fillActualColor": false,
        "annotation_type": "COLOR",
        "single_order_ai": true,
        "hasMaster": true,
        "cropMasterHeight": true,
        "master_group_by_color": true,
        "master_frame_width_mm": 450,
        "master_frame_height_mm": 2000,
        "artwork_content": "订单号 + 字体颜色 + 效果图",
        "save_strategy": "先按单保存，再按颜色排版为一个整体 AI8 文件",
        "layout": {
          "group_by_color": true,
          "frame_width_mm": 450,
          "frame_height_mm": 2000,
          "color_label_outside_frame": true,
          "keep_same_order_together": true,
          "master_packing": {
            "algorithm": "adaptive_column_grid",
            "target_width_mm": 450,
            "item_gap_mm": 2,
            "column_gap_mm": 2,
            "outer_margin_mm": 2,
            "header_height_mm": 7,
            "color_gap_mm": 4,
            "label_height_mm": 4,
            "label_gap_mm": 0.8,
            "row_slack": 1,
            "cell_width_padding_mm": 0.8,
            "component_suppress_labels": true,
            "force_subitem_order_labels": false,
            "allow_rotation": false
          }
        },
        "file_naming": "店名+几单几图日期+生产部门，例如 T-5411D58T0816ZK 或 T-5411D58T0816FK"
      },
      {
        "name": "PW_EW",
        "departments": ["PW", "EW"],
        "output_format": "ai8",
        "exportUnit": "PER_ORDER",
        "fileFormat": "AI8",
        "fillActualColor": false,
        "annotation_type": "PRODUCT_NAME",
        "single_order_ai": true,
        "hasMaster": true,
        "cropMasterHeight": false,
        "master_group_by_color": false,
        "artwork_content": "订单号 + 产品中文名称 + 效果图",
        "save_strategy": "先按单保存为 AI8，再将所有订单放在一个 AI8 文件中",
        "layout": {
          "fixed_size_required": false,
          "keep_same_order_together": true,
          "arrange_neatly": true
        }
      },
      {
        "name": "D_CONTAINS",
        "match": "contains",
        "departments": ["D"],
        "output_format": "ai8",
        "exportUnit": "PER_ORDER",
        "fileFormat": "AI8",
        "fillActualColor": false,
        "annotation_type": "PRODUCT_NAME",
        "single_order_ai": true,
        "hasMaster": false,
        "cropMasterHeight": false,
        "master_group_by_color": false,
        "artwork_content": "订单号 + 产品中文名称 + 效果图",
        "save_strategy": "按单保存为 AI8 文件"
      },
      {
        "name": "H",
        "departments": ["H"],
        "output_format": "png_cmyk",
        "exportUnit": "PER_GRAPHIC",
        "fileFormat": "PNG_CMYK",
        "fillActualColor": true,
        "single_order_ai": false,
        "hasMaster": true,
        "cropMasterHeight": true,
        "master_group_by_color": false,
        "master_frame_width_mm": 580,
        "master_frame_height_mm": 2000,
        "artwork_content": "订单号 + 效果图；字体颜色填充到名字本身",
        "save_strategy": "每张效果图单独保存 CMYK PNG，并额外生成一张 580mm 宽、按内容高度裁剪的总 PNG",
        "layout": {
          "frame_width_mm": 580,
          "frame_height_mm": 2000,
          "max_height_mm": 2000,
          "dpi": 300,
          "color_mode": "CMYK",
          "keep_same_order_together": true,
          "crop_master_height": true
        }
      },
      {
        "name": "W_CONTAINS",
        "match": "contains",
        "departments": ["W"],
        "output_format": "manufacturer_specific",
        "artwork_content": "按厂家判断，不同厂家作图要求和输出格式不同",
        "manufacturer_rules": [
          {
            "manufacturer": "MY-W196",
            "output_format": "cs5_ai",
            "exportUnit": "PER_ORDER",
            "fileFormat": "AI_CS5",
            "fillActualColor": true,
            "hasMaster": false,
            "artwork_content": "订单号 + 效果图；字体颜色填充到名字本身",
            "save_strategy": "保存为整体 CS5 AI 文件"
          },
          {
            "manufacturer": "MY-W120",
            "output_format": "png_cmyk",
            "exportUnit": "PER_GRAPHIC",
            "fileFormat": "PNG_CMYK",
            "fillActualColor": true,
            "hasMaster": false,
            "cropMasterHeight": false,
            "dpi": 300,
            "artwork_content": "每张效果图单独输出 CMYK PNG；字体颜色填充到名字本身",
            "file_naming": "单图为订单号.png；同一订单多图为订单号-1.png、订单号-2.png"
          },
          {
            "manufacturer": "other",
            "output_format": "ai_standard",
            "exportUnit": "PER_ORDER",
            "fileFormat": "AI_STANDARD",
            "fillActualColor": false,
            "hasMaster": false,
            "save_strategy": "所有其他 W 厂家均按订单保存为标准 AI 文件"
          }
        ]
      }
    ]
  },
  "rules": [
    {
      "name": "H",
      "display_name": "H 部门",
      "description": "标注订单号，不带框；效果图本体按订单字体颜色渲染。",
      "match": "exact",
      "departments": ["H"],
      "label_fields": ["order_no"],
      "label_lines": [["order_no"]],
      "apply_color_to_artwork": true,
      "show_frame": false
    },
    {
      "name": "K_T_FK_ZK",
      "display_name": "K/T/FK/ZK 部门",
      "description": "标注订单号和字体颜色，不带框；同订单同颜色的多个定制内容共用一组标注，竖向排成一列。",
      "match": "exact",
      "departments": ["K", "T", "FK", "ZK"],
      "annotation_type": "COLOR",
      "label_fields": ["order_no", "color_option"],
      "label_lines": [["order_no"], ["color_option"]],
      "apply_color_to_artwork": false,
      "show_frame": false
    },
    {
      "name": "D_CONTAINS",
      "display_name": "含 D 部门",
      "description": "标注订单号和产品名称，输出带框设计图。",
      "match": "contains",
      "departments": ["D"],
      "annotation_type": "PRODUCT_NAME",
      "label_fields": ["order_no", "product_name"],
      "label_lines": [["order_no"], ["product_name"]],
      "apply_color_to_artwork": false,
      "show_frame": true
    },
    {
      "name": "PW_EW",
      "display_name": "PW/EW 部门",
      "description": "标注订单号和产品中文名称，输出设计图。",
      "match": "exact",
      "departments": ["PW", "EW"],
      "annotation_type": "PRODUCT_NAME",
      "label_fields": ["order_no", "product_name"],
      "label_lines": [["order_no"], ["product_name"]],
      "apply_color_to_artwork": false,
      "show_frame": false
    }
  ]
}
