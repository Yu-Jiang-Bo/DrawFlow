# Copy this file to drawflow.env or /etc/drawflow-central/drawflow.env.
# Keep the real file out of release archives and set chmod 600 on it.
DRAWFLOW_HOST=0.0.0.0
DRAWFLOW_PORT=8765
# Leave unset to use any V2 template data bundled under <install-dir>/drawflow-data.
# Set an absolute path only when you intentionally manage template data outside the package.
# DRAWFLOW_DATA_DIR=/opt/drawflow-data
DRAWFLOW_LOG_DIR=/opt/drawflow-central/output/logs
DRAWFLOW_PID_FILE=/opt/drawflow-central/output/logs/drawflow.pid

# Configure these only on the central service host. Never copy the real key to a client.
DRAWFLOW_LLM_BASE_URL=
DRAWFLOW_LLM_MODEL=rule-parser
DRAWFLOW_LLM_TIMEOUT_SECONDS=30
# DRAWFLOW_LLM_API_KEY=

# Shared only by the central service and trusted Windows preview workers.
# Generate at least 32 random bytes; never commit or log the real value.
# DRAWFLOW_PREVIEW_WORKER_SECRET=

# Shared only by the central service and trusted Windows Illustrator scanners.
# Keep this distinct from DRAWFLOW_PREVIEW_WORKER_SECRET. It signs automatic
# OpenType/PUA tail-profile scans for the exact current AI file and draft.
# DRAWFLOW_SCAN_WORKER_SECRET=
